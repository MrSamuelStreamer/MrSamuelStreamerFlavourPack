<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <SoundDef>
        <defName>MSSFP_GachaGun_Fire</defName>
        <context>MapOnly</context>
        <maxSimultaneous>1</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MSSFP_GachaGun</clipPath>
                    </li>
                </grains>
                <pitchRange>0.8~1.2</pitchRange>
                <volumeRange>30~50</volumeRange>
            </li>
        </subSounds>
    </SoundDef>

    <SoundDef>
        <defName>MSSFP_GruntBirthday</defName>
        <context>MapOnly</context>
        <maxSimultaneous>1</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MSSFP_GruntBirthday</clipPath>
                    </li>
                </grains>
                <pitchRange>1</pitchRange>
                <volumeRange>30~50</volumeRange>
            </li>
        </subSounds>
    </SoundDef>

    <SoundDef>
        <defName>MSSFP_BananaFall</defName>
        <context>MapOnly</context>
        <maxSimultaneous>1</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MSSFP_BananaFall</clipPath>
                    </li>
                </grains>
                <pitchRange>1</pitchRange>
