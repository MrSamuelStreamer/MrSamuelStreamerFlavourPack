        <modExtensions>
            <li Class="MSSFP.Projectiles.ProjectileModExtension">
                <spawnCount>1~10</spawnCount>
                <angry>true</angry>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MSSFP_GachaGun_Healing</defName>
        <label>healer</label>
        <thingClass>MSSFP.Projectiles.Projectile_Heals</thingClass>
        <uiIconPath>Things/Projectile/Bullet_Small</uiIconPath>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MSSFP_GachaGun_RoofCollapse</defName>
        <label>roof collapse</label>
        <thingClass>MSSFP.Projectiles.Projectile_RoofCollapse</thingClass>
        <uiIconPath>Things/Projectile/Bullet_Small</uiIconPath>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MSSFP_GachaGun_BananaPeel</defName>
        <label>banana peel</label>
        <thingClass>Projectile_SpawnsThing</thingClass>
        <uiIconPath>Things/Building/MSSFP_BananaPeel</uiIconPath>
        <graphicData>
            <texPath>Things/Building/MSSFP_BananaPeel</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <spawnsThingDef>MSSFP_BananaPeel</spawnsThingDef>
        </projectile>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>MSSFP_BananaPeel</defName>
        <label>banana peel</label>
        <description>A banana peel</description>
        <thingClass>MSSFP.Buildings.Building_BananaPeel</thingClass>
        <graphicData>
            <texPath>Things/Building/MSSFP_BananaPeel</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <damageData>
                <rect>(0,0,1,0.15)</rect>
            </damageData>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <rotatable>false</rotatable>
        <tickerType>Normal</tickerType>
        <stealable>false</stealable>
        <minifiedDef>MinifiedThing</minifiedDef>
        <uiOrder>30</uiOrder>
        <thingCategories>
            <li>BuildingsSecurity</li>
        </thingCategories>
        <statBases>
            <Mass>2.5</Mass>
            <MaxHitPoints>40</MaxHitPoints>
            <WorkToBuild>3200</WorkToBuild>
            <Flammability>1</Flammability>
            <Beauty>-18</Beauty>
            <Cleanliness>-5</Cleanliness>
            <TrapMeleeDamage>100</TrapMeleeDamage>
            <TrapSpringChance>1.0</TrapSpringChance>
        </statBases>
        <costList>
            <WoodLog>1</WoodLog>
        </costList>
        <designationCategory>Security</designationCategory>
        <designationHotKey>Misc6</designationHotKey>
        <building>
            <isTrap>true</isTrap>
            <trapDestroyOnSpring>true</trapDestroyOnSpring>
            <trapDamageCategory>Sharp</trapDamageCategory>
            <expandHomeArea>false</expandHomeArea>
            <ai_chillDestination>false</ai_chillDestination>
        </building>
        <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
        <placeWorkers>
            <li>PlaceWorker_NeverAdjacentTrap</li>
        </placeWorkers>
    </ThingDef>
</Defs>
