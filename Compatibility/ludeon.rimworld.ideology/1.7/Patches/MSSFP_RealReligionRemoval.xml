<?xml version="1.0" encoding="UTF-8" ?>
<Patch>
    <!-- Removing specific names (Christ, Allah, etc) and keeping things more generic -->
    <!-- Christian -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginChristian"]/label</xpath>
        <value>
            <label>Church Origin</label>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginChristian"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religion. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginChristian"]/generalRules</xpath>
        <value>
            <generalRules>
                <rulesStrings>
                    <li>r_ideoName(p=99)->[globalAdjective] [packIdeoName]</li>
                    <li>r_ideoName(p=99)->[memeAdjective] [packIdeoName]</li>
                    <li>r_ideoName(p=99)->[packAdjective] [packIdeoName]</li>
                    <li>r_ideoName(p=99)->[packIdeoName]</li>
                    <li>memeLeaderNoun->bishop</li>
                    <li>memeLeaderNoun->cardinal</li>
                    <li>memeLeaderNoun->pope</li>
                    <li>memeLeaderNoun->pontiff</li>
                    <li>memeLeaderNoun->legate</li>
                    <li>memeLeaderNoun->nuncio</li>
                    <li>memeLeaderNoun->divus</li>
                    <li>memeLeaderNoun->ecclesiast</li>
                    <li>memeLeaderAdjective->holy</li>
                    <li>memeLeaderAdjective->divine</li>
                    <li>memeLeaderAdjective->God's</li>
                    <li>memeMoralist->priest</li>
                    <li>memeMoralist->pastor</li>
                    <li>memeMoralist->cleric</li>
                    <li>memeMoralist->preacher</li>
                    <li>memeMoralist->rector</li>
                    <li>memeMoralist->abbot</li>
                </rulesStrings>
            </generalRules>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RulePackDef[defName="NamerDeityChristian"]/rulePack</xpath>
        <value>
            <rulePack>
                <rulesStrings>
                    <li>r_deityName(p=3)->God</li>
                    <li>r_deityName->Lord</li>
                    <li>r_deityName->Holy One</li>
                </rulesStrings>
            </rulePack>
        </value>
    </Operation>
    <!-- Islam -->
