                    <li>r_deityName->Al-Wahhab</li>
                    <li>r_deityName->Al-Fattah</li>
                    <li>r_deityName->Al-Alim</li>
                    <li>r_deityName->Al-Hakam</li>
                </rulesStrings>
            </rulePack>
        </value>
    </Operation>
    <!-- Hindu -->
    <!-- Very hard to reduce Hindu without totally replacing, deity names are fixed -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginHindu"]/label</xpath>
