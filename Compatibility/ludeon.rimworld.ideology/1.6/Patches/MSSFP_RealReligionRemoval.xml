<?xml version="1.0" encoding="UTF-8" ?>
<Patch>
    <!-- Removing specific names (Christ, Allah, etc) and keeping things more generic -->
    <!-- This whole thing is because an ideology randomly generated to discuss a gods followers getting high and "killing Allah" - I didn't want the angry comments that might cause.-->
    <!-- Also felt weird that religions would use the same name and styles and religion iconography another 2500 years later -->
    <!-- Christian -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginChristian"]/label</xpath>
        <value>
            <label>Stauros Origin</label> <!-- Empire is vaguely Greek, Stauros is Greek for Cross -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginChristian"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religion. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginChristian"]/generalRules</xpath>
        <value>
            <generalRules>
                <rulesStrings>
                    <li>r_ideoName(p=99)->[globalAdjective] [packIdeoName]</li>
                    <li>r_ideoName(p=99)->[memeAdjective] [packIdeoName]</li>
                    <li>r_ideoName(p=99)->[packAdjective] [packIdeoName]</li>
                    <li>r_ideoName(p=99)->[packIdeoName]</li>
                    <li>memeLeaderNoun->bishop</li>
                    <li>memeLeaderNoun->cardinal</li>
                    <li>memeLeaderNoun->pope</li>
                    <li>memeLeaderNoun->pontiff</li>
                    <li>memeLeaderNoun->legate</li>
                    <li>memeLeaderNoun->nuncio</li>
                    <li>memeLeaderNoun->divus</li>
                    <li>memeLeaderNoun->ecclesiast</li>
                    <li>memeLeaderAdjective->holy</li>
                    <li>memeLeaderAdjective->divine</li>
                    <li>memeLeaderAdjective->God's</li>
                    <li>memeMoralist->priest</li>
                    <li>memeMoralist->pastor</li>
                    <li>memeMoralist->cleric</li>
                    <li>memeMoralist->preacher</li>
                    <li>memeMoralist->rector</li>
                    <li>memeMoralist->abbot</li>
                </rulesStrings>
            </generalRules>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RulePackDef[defName="NamerDeityChristian"]/rulePack</xpath>
        <value>
            <rulePack>
                <rulesStrings>
                    <li>r_deityName(p=3)->God</li>
                    <li>r_deityName->Lord</li>
                    <li>r_deityName->The Almighty</li>
                </rulesStrings>
            </rulePack>
        </value>
    </Operation>
    <!-- Islam -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginIslamic"]/label</xpath>
        <value>
            <label>Meniskos Origin</label>   <!-- Empire is vaguely Greek, Meniskos is Greek for Crescent -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginIslamic"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religion. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RulePackDef[defName="NamerDeityIslamic"]/rulePack</xpath>
        <value>
            <rulePack>  <!-- based on Al-Asm?? al-?usn?, the 99 names of god in Islam, while keeping it detached enough that offence wont be caused by randomiser -->
                <rulesStrings>
                    <li>r_deityName->The God</li>
                    <li>r_deityName->One True Deity</li>
                    <li>r_deityName->The Beneficent</li>
                    <li>r_deityName->The Merciful</li>
                </rulesStrings>
            </rulePack>
        </value>
    </Operation>
    <!-- Hindu -->
    <!-- Very hard to reduce Hindu without totally replacing, deity names are fixed -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginHindu"]/label</xpath>
        <value>
            <label>Indik? Origin</label>   <!-- Empire is vaguely Greek, Indike is Greek for India -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginHindu"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religion. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <!-- Buddhist -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginBuddhist"]/label</xpath>
        <value>
            <label>Sarmanai Origin</label>   <!-- Empire is vaguely Greek, Sarmanai is an ancient Greek transliteration of people who were believed to follow proto-buddhist teachings -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="Structure_OriginBuddhist"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religion. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
</Patch>
