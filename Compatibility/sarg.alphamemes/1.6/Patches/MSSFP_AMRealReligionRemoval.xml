<?xml version="1.0" encoding="UTF-8" ?>
<Patch>
    <!-- Removing specific names (Christ, Allah, etc) and keeping things more generic -->
    <!-- This whole thing is because an ideology randomly generated to discuss a gods followers getting high and "killing Allah" - I didn't want the angry comments that might cause.-->
    <!-- Also felt weird that religions would use the same name and styles and religion iconography another 2500 years later -->
    <!-- Jewish -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Jewish"]/label</xpath>
        <value>
            <label>Ioudaioi Origin</label> <!-- Empire is vaguely Greek, Ioudaioi is ancient Greek plural for "jewish", bit on the nose but slightly more vague -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Jewish"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religions. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Jewish"]/generalRules</xpath>
        <value>
            <generalRules>
                <rulesStrings>
                    <li>memeAdjective->traditional</li>
                    <li>memeAdjective->orthodox</li>
                    <li>memeAdjective->spiritual</li>
                    <li>memeLeaderAdjective->wise</li>
                    <li>memeLeaderAdjective->sagely</li>
                    <li>memeLeaderAdjective->respected</li>
                </rulesStrings>
            </generalRules>
        </value>
    </Operation>
    <!-- Jain -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Jainism"]/label</xpath>
        <value>
            <label>Gymnosophist Origin</label> <!-- Empire is vaguely Greek, Gymnosophist is ancient Greek plural for proto-jain adherants -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Jainism"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religions. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Jainism"]/generalRules</xpath>
        <value>
            <generalRules>
                <rulesStrings>
                    <li>memeAdjective->pacifist</li>
                    <li>memeAdjective->nonviolent</li>
                    <li>memeAdjective->mendicant</li>
                    <li>memeLeaderAdjective->learned</li>
                    <li>memeLeaderAdjective->ascetic</li>
                    <li>memeLeaderAdjective->venerable</li>
                </rulesStrings>
            </generalRules>
        </value>
    </Operation>
    <!-- Sikh -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Sikhism"]/label</xpath>
        <value>
            <label>Math?t?s Origin</label> <!-- Empire is vaguely Greek. "Sikh" comes from the sanskrit word meaning disciple/learner, Math?t?s has the same meaning -->
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Sikhism"]/description</xpath>
        <value>
            <description>This is a variant of the abstract theist structure. This ideoligion is a descendant of an ancient earth religions. It may have very different precepts than those of thousands of years ago, but its symbols are similar.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MemeDef[defName="AM_Structure_Sikhism"]/generalRules</xpath>
        <value>
            <generalRules>
                <rulesStrings>
                    <li>memeAdjective->true</li>
                    <li>memeAdjective->righteous</li>
                    <li>memeAdjective->spiritual</li>
                </rulesStrings>
            </generalRules>
        </value>
    </Operation>
</Patch>
