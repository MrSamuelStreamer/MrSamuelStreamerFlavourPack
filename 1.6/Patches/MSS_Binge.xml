<?xml version="1.0" encoding="UTF-8" ?>
<Patch>
    <!-- Deliberately unqualified: enables bingeing on EVERY ChemicalDef in the
         load order (including other mods'). This is intended chaos-pack behavior. -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ChemicalDef/canBinge</xpath>
        <value>
            <canBinge>true</canBinge>
        </value>
    </Operation>
</Patch>
